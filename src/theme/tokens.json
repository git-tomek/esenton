{
  "$schema": "./tokens.schema.json",
  "_meta": {
    "description": "SINGLE SOURCE OF TRUTH for design tokens. Edit here only.",
    "consumers": [
      "src/theme/tokens.ts (imports this JSON for MUI/TS)",
      "src/styles/tokens.generated.css (auto-generated by scripts/sync-tokens.mjs, imported by src/app/globals.css)"
    ],
    "regenerate": "node scripts/sync-tokens.mjs"
  },
  "colors": {
    "navy": "#2A3D7A",
    "navyDark": "#02073A",
    "blue": "#0A45DB",
    "blueDark": "#082FAE",
    "blueDarker": "#061F82",
    "blueSoft": "#EEF3FB",
    "blueLight": "#DCE9FE",
    "green": "#6FA9B3",
    "greenSoft": "#F2FBFD",
    "greenHighlight": "#8BD58B",
    "cream": "#DECBB7",
    "creamSoft": "#F6F0E9",
    "text": "#1F1F22",
    "muted": "#64748B",
    "mutedDark": "#475569",
    "background": "#F5F5F2",
    "surface": "#FFFFFF",
    "border": "#D4D4D2",
    "borderSoft": "#EEEDE9"
  },
  "radius": {
    "sm": "6px",
    "md": "8px",
    "lg": "10px",
    "xl": "10px",
    "full": "999px"
  },
  "shadow": {
    "defaultShadow": "0 1px 1px rgba(16, 36, 63, 0.07)",
    "defaultShadowHover": "0 1px 2px rgba(16, 36, 63, 0.09)",
    "cardShadow": "0 16px 40px rgba(16, 36, 63, 0.07)"
  },
  "layout": {
    "container": "1320px",
    "headerTop": "32px",
    "headerMain": "86px",
    "sectionY": "72px"
  },
  "font": {
    "sans": "var(--font-inter), system-ui, -apple-system, \"Segoe UI\", sans-serif"
  }
}
